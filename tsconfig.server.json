{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "noEmit": false,
    "declaration": false
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"],
  "exclude": ["server/__tests__/**"]
}
